#COPY ./yii .
#COPY ./config/web.php ./config/web.php
#COPY ./composer.json ./composer.json
#COPY . .
#RUN composer global require "fxp/composer-asset-plugin:~1.3"
#RUN composer install

COPY . .

WORKDIR /app/web/echr
