FROM yiisoftware/yii2-php:8.3-apache

# yii2-gii (required transitively by johnitvn/yii2-rbac-plus) only has versions
# flagged by security advisories, so composer would refuse to install them.
# Allow them through; gii is a dev-only generator.
ENV COMPOSER_NO_SECURITY_BLOCKING=1

RUN mkdir -p /usr/share/man/man1
RUN apt update -y
RUN apt install -y default-jdk libtidy-dev
RUN docker-php-ext-install tidy \
    && docker-php-ext-enable tidy
RUN cd /usr/local/etc/php/conf.d/ && \
  echo 'memory_limit = -1' >> /usr/local/etc/php/conf.d/docker-php-ram-limit.ini

# LibreOffice provides the `soffice` binary used by phpdocx transformDocument(..., 'libreoffice')
# to convert DOCX -> PDF. Install the distro package (compatible with the Debian 13 base of the
# 8.3 image) instead of the old bundled 6.3 .deb files, which target an older Debian and fail to
# install here.
RUN apt install -y --no-install-recommends libreoffice-writer libreoffice-calc

WORKDIR /app/web/echr

#COPY  ./web/assets ./web/assets
